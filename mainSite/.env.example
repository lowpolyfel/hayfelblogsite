# Copia este archivo a .env (que está ignorado por git) o pega estos valores
# en el panel de Node.js de Hostinger. Ninguno de ellos va al repositorio.

# --- Twitch --------------------------------------------------------------
# De https://dev.twitch.tv/console/apps, aplicacion de tipo Confidential.
# Hay que registrar como OAuth Redirect URL:  <PUBLIC_URL>/api/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Solo este canal puede entrar. Vacio = cualquiera con cuenta de Twitch.
TWITCH_ALLOWED_LOGIN=hayfel

# --- Supabase ------------------------------------------------------------
# La service_role se salta el RLS de la tabla: es la unica que puede leer los
# refresh tokens. No debe aparecer nunca en el frontend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Este servidor -------------------------------------------------------
# Cadena larga y aleatoria para firmar la cookie de sesion. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Direccion publica del sitio, sin barra final.
PUBLIC_URL=https://www.hayfel.com

# Hostinger suele inyectar PORT. En local, 3000.
PORT=3000
NODE_ENV=production
